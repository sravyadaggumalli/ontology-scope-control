<owl:Class rdf:about="#ScopeConcept">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CityServiceRequest">
  <rdfs:subClassOf rdf:resource="#ScopeConcept"/>
  <owl:disjointWith rdf:resource="#NotHandled"/>
